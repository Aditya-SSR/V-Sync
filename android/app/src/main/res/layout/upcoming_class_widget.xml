<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Android.AppWidget.Container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:theme="@style/Theme.Android.AppWidgetContainer">

    <!-- Section label -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:text="NEXT CLASS"
        android:fontFamily="@font/inter_medium"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:textColor="@color/widget_title_color" />

    <!-- Refresh Button -->
    <ImageButton
        android:id="@+id/refresh_button"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_refresh"
        android:contentDescription="Refresh" />

    <!-- Course name -->
    <TextView
        android:id="@+id/course_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_title"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/outfit_bold"
        android:textSize="19sp"
        android:textColor="@color/widget_text_primary"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/appwidget_course_name" />

    <!-- Timing -->
    <TextView
        android:id="@+id/timing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/course_name"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/outfit_medium"
        android:textSize="14sp"
        android:textColor="@color/widget_text_primary"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/appwidget_timing" />

    <!-- Faculty -->
    <TextView
        android:id="@+id/faculty_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/timing"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/appwidget_faculty_name" />

    <!-- Venue -->
    <TextView
        android:id="@+id/venue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/faculty_name"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/appwidget_venue" />

</RelativeLayout>
